FAMILYCART_JWT_SECRET=replace-with-at-least-32-random-bytes
FAMILYCART_USER_DATABASE_URL=postgresql://familycart_user:familycart_local_password@127.0.0.1:5433/familycart_users
FAMILYCART_DATABASE_URL=postgresql://familycart_app:familycart_local_password@127.0.0.1:5434/familycart
FAMILYCART_REDIS_URL=redis://127.0.0.1:6379/0
FAMILYCART_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FAMILYCART_COOKIE_SECURE=0
FAMILYCART_GOOGLE_CLIENT_ID=replace-with-your-google-web-client-id.apps.googleusercontent.com
FAMILYCART_AUTH_URL=http://127.0.0.1:8001
FAMILYCART_API_URL=http://127.0.0.1:8002
FAMILYCART_REFRESH_URL=http://127.0.0.1:8003
FAMILYCART_MAPS_URL=http://127.0.0.1:8004
# Enables simulated decline controls for local checkout testing.
FAMILYCART_DEMO_CHECKOUT=1
VITE_GOOGLE_CLIENT_ID=replace-with-the-same-google-web-client-id.apps.googleusercontent.com
# Set both to use a different tile provider. An empty tile URL disables background tiles.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
